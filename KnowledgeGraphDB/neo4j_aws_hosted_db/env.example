# Neo4j AWS Hosted Database Configuration
# Copy this file to .env and fill in your actual credentials

# ===================================================================
# AWS HOSTED NEO4J GRAPH DATABASE
# ===================================================================

# Connection URL - This is the HTTP URL for the Neo4j Browser (port 7474)
# The connection module will automatically convert this to Bolt protocol (port 7687)
AWS_NEO4J_CONNECTION_URL=http://44.243.196.65:7474/

# Database credentials
AWS_NEO4J_USERNAME=neo4j
AWS_NEO4J_PASSWORD=your_password_here

# Optional: Target database (defaults to "neo4j")
# AWS_NEO4J_DATABASE=neo4j

# ===================================================================
# OPENAI CONFIGURATION (Required for GraphRAG functionality)
# ===================================================================

# OpenAI API Key for LLM and embedding generation
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: OpenAI model configurations
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ===================================================================
# CONNECTION POOL CONFIGURATION (Optional)
# ===================================================================

# Maximum connection lifetime in seconds (default: 3600)
# NEO4J_MAX_CONNECTION_LIFETIME=3600

# Maximum size of the connection pool (default: 50)
# NEO4J_MAX_CONNECTION_POOL_SIZE=50

# Timeout for acquiring a connection from the pool in seconds (default: 60.0)
# NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60.0

# ===================================================================
# RETRY CONFIGURATION (Optional)
# ===================================================================

# Maximum number of retry attempts for transient errors (default: 3)
# NEO4J_MAX_RETRY_ATTEMPTS=3

# Delay between retry attempts in seconds (default: 1.0)
# NEO4J_RETRY_DELAY=1.0

# ===================================================================
# LOGGING CONFIGURATION (Optional)
# ===================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Log file path (if not set, logs to console only)
# LOG_FILE=/var/log/neo4j_connection.log
