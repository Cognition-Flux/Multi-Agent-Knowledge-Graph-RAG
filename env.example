# ===================================================================
# AWS HOSTED NEO4J DATABASE CONFIGURATION
# ===================================================================
# Copy this file to .env in the project root and fill in your credentials

# Connection URL - HTTP URL for Neo4j Browser (will be converted to Bolt)
AWS_NEO4J_CONNECTION_URL=http://44.243.196.65:7474/

# Database credentials
AWS_NEO4J_USERNAME=neo4j
AWS_NEO4J_PASSWORD=your_password_here

# Optional: Target database (defaults to "neo4j")
# AWS_NEO4J_DATABASE=neo4j

# ===================================================================
# LEGACY NEO4J CONFIGURATION (for backward compatibility)
# ===================================================================
# These are the old environment variables that some modules might still use
# They should point to the same AWS-hosted database

NEO4J_CONNECTION_URI_UPGRADED=bolt://44.243.196.65:7687
NEO4J_USERNAME_UPGRADED=neo4j
NEO4J_PASSWORD_UPGRADED=your_password_here

# ===================================================================
# EMBEDDINGS CONFIGURATION
# ===================================================================

# AWS Bedrock Embeddings (required for vector embeddings in GraphRAG)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Other options: amazon.titan-embed-image-v1

# ===================================================================
# LLM CONFIGURATION
# ===================================================================

# Azure OpenAI (if using Azure)
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview
AZURE_OPENAI_API_KEY=your_azure_openai_key_here

# AWS Bedrock (if using Bedrock)
AWS_BEDROCK_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_BEARER_TOKEN_BEDROCK=your_bearer_token_here

# ===================================================================
# CONNECTION POOL CONFIGURATION (Optional)
# ===================================================================

# Maximum connection lifetime in seconds (default: 3600)
# NEO4J_MAX_CONNECTION_LIFETIME=3600

# Maximum size of the connection pool (default: 50)
# NEO4J_MAX_CONNECTION_POOL_SIZE=50

# Timeout for acquiring a connection from the pool in seconds (default: 60.0)
# NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60.0

# ===================================================================
# RETRY CONFIGURATION (Optional)
# ===================================================================

# Maximum number of retry attempts for transient errors (default: 3)
# NEO4J_MAX_RETRY_ATTEMPTS=3

# Delay between retry attempts in seconds (default: 1.0)
# NEO4J_RETRY_DELAY=1.0

# ===================================================================
# LOGGING CONFIGURATION (Optional)
# ===================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO
